{
  "name": "Hello Workflow",
  "version": "1.0.0",
  "description": "Simple workflow to test plugin execution.",
  "variables": {
    "environment": "development"
  },
  "steps": [
    {
      "name": "Print Greeting",
      "plugin": "builtin.hello",
      "enabled": true,
      "continue_on_error": false,
      "arguments": {
        "message": "Hello Entropy!"
      }
    }
  ]
}
