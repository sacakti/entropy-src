{
    "application": {
        "name": "Entropy",
        "version": "1.0.0"
    },
    "console": {
        "banner": false,
        "level": "INFO"
    },
    "logging": {
        "level": "INFO",
        "directory": "./logs",
        "rotation": {
            "size_mb": 20,
            "backups": 10
        }
    },
    "database": {
        "path": "./database/entropy.db"
    },
    "runtime": {
        "workspace": "./runtime",
        "cleanup": false,
        "retain_days": 30
    },
    "session": {
        "directory": "./session"
    },
    "python": {
        "packages": "./site-packages"
    },
    "workflow": {
        "directory": "./workflow",
        "default": "default",
        "jobs": {
            "max_concurrent": 10,
            "poll_interval": 1,
            "resources": {
                "cpu": {
                    "enabled": false
                },
                "memory": {
                    "enabled": false
                }
            }
        }
    },
    "git": {
        "repository": "./repository"
    },
    "plugins": {
        "directory": "./plugins"
    },
    "auth": {
        "session": {
            "timeout": 8
        }
    }
}
