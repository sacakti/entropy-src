{
    "name": "SyncYamlsPlugin",
    "version": "1.0.0",
    "description": "Synchronize OpenShift resources into the YAML repository.",

    "variables": {
        "env": {
            "sit": {
                "namespace": "${entv:sit_ocp_namespace}",
                "repo_name": "SITRepo"
            },
            "uat": {
                "namespace": "${entv:uat_ocp_namespace}",
                "repo_name": "UATRepo"
            }
        },

        "environment": "sit",
        "yaml_repository": "/Users/aravinthselvaraj/Desktop/repo/${env[${environment}].repo_name}"
    },

    "steps": [
        {
            "name": "SyncYamls",
            "plugin": "oc.sync_yamls",
            "enabled": true,
            "on_failure": "abort",

            "tags": [
                "openshift",
                "sync_yamls"
            ],

            "arguments": {
                "namespace": "${env[${environment}].namespace}",
                "yaml_repository": "${yaml_repository}",

                "ignore_resources": {
                    "configmaps": {
                        "names": [],
                        "keys": [
                            "kube.crt"
                        ]
                    },
                    "secrets": {
                        "names": [],
                        "keys": []
                    }
                }
            }
        }
    ]
}
