{
    "name": "GenericPlugin Workflow",
    "version": "1.0.0",
    "description": "Example workflow for builtin.git.",

    "variables": {

    },

    "steps": [
        {
            "name": "CommitRevision",
            "plugin": "builtin.git",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "operation": "revision",
                "repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT"
            }
        },
        {
            "name": "CommitDeployment",
            "plugin": "builtin.git",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "operation": "deployment",
                "repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT",
                "tag": "1.1.10"
            }
        },
        {
            "name": "PushDeployment",
            "plugin": "builtin.git",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "operation": "push",
                "repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT"
            }
        }
    ]
}
