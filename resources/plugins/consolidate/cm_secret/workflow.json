{
    "name": "consolidated-cm-secret",
    "version": "1.0.0",
    "description": "Example workflow for consolidate.cm_secret: merge the ConfigMap/Secret changes of all releases in a folder, then apply the result to the YAML repository with oc.cm_secret_update.",
    "variables": {
        "release_directory": "/opt/releases/2026-R4",
        "yaml_repository": "/opt/entropy/yamls/SIT"
    },
    "steps": [
        {
            "name": "ConsolidateCmSecret",
            "plugin": "consolidate.cm_secret",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "consolidate"
            ],
            "arguments": {
                "release_directory": "${release_directory}"
            }
        },
        {
            "name": "ApplyCmSecret",
            "plugin": "oc.cm_secret_update",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "openshift"
            ],
            "arguments": {
                "mode": "folder",
                "source": "${steps.ConsolidateCmSecret.outputs.output_directory}",
                "target": "${yaml_repository}"
            }
        }
    ]
}
