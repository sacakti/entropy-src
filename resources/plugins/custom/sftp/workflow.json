{
    "name": "SFTP Put Test",
    "version": "1.0.0",
    "variables": {
        "sftp_creds": "${entv:sftp/creds}",
        "name" : "aravinthan"
    },
    "steps": [
        {
            "name": "Upload Release",
            "plugin": "custom.sftp",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "operation": "put",
                "source": "/Users/aravinthselvaraj/Documents/entropy/build/entropy.1.3.4.epkg",
                "destination": "/02-IntellectRelease/TRADE",
                "archive": {
                    "enabled": true,
                    "filename_policy": "TEST_${name}"
                },
                "sftp": "${sftp_creds}",
                "settings": {
                    "connection": {
                        "timeout": 30,
                        "banner_timeout": 30,
                        "auth_timeout": 30
                    },
                    "algorithms": {
                        "kex": "diffie-hellman-group14-sha1",
                        "host_key": "ssh-rsa",
                        "cipher": "aes128-ctr",
                        "mac": null
                    },
                    "host_key": {
                        "policy": "auto_add"
                    }
                }
            },
            "tags" : [
                "put"
            ]
        },
        {
            "name": "List Folder",
            "plugin": "custom.sftp",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "operation": "list",
                "source": "/02-IntellectRelease/TRADE",
                "sftp": "${sftp_creds}",
                "settings": {
                    "connection": {
                        "timeout": 30,
                        "banner_timeout": 30,
                        "auth_timeout": 30
                    },
                    "algorithms": {
                        "kex": "diffie-hellman-group14-sha1",
                        "host_key": "ssh-rsa",
                        "cipher": "aes128-ctr",
                        "mac": null
                    },
                    "host_key": {
                        "policy": "auto_add"
                    }
                }
            },
            "tags" : [
                "list"
            ]
        }
    ]
}
