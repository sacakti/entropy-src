{
    "name": "StageReleaseCopy",
    "version": "1.0.0",
    "description": "Stage release artifacts into the local Docker repository.",
    "variables": {},
    "steps": [
        {
            "name": "Stage Release",
            "plugin": "custom.stage_release_copy",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "release",
                "stage"
            ],
            "arguments": {
                "source": "/home/aravinthans/releases/H001/App/Services/",
                "destination": "/home/aravinthans/repo/DOCKER_API/",
                "backup": true,
                "rotate_backup_type": "max_files",
                "max_files": 3,
                "max_timestamp": 3,
                "max_timestamp_unit": "days",
                "artifact_matching": {
                    "enabled": true,
                    "patterns": [
                        "*.jar",
                        "*.war"
                    ],
                    "rule": "move"
                }
            }
        }
    ]
}
