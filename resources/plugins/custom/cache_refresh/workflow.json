{
    "name": "Cache Refresh Validation",
    "version": "1.0.0",
    "description": "Validate cache refresh configuration and OpenShift access.",

    "variables": {},

    "steps": [
        {
            "name": "CacheRefresh",
            "plugin": "custom.cache_refresh",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "openshift",
                "cache"
            ],
            "arguments": {
                "environment": "dev",
                "namespace": "app-dev",

                "rebuild": true,

                "stop_all_before_cache_rebuild": true,

                "mode": "force",

                "parallel": false,

                "services": [
                    "app1",
                    "app2",
                    "cache",
                    "app3"
                ],

                "cache": {
                    "deployment": "cache",

                    "environment": {
                    "name": "CACHE_REFRESH",
                    "value": "true"
                    },

                    "readiness": {
                    "ready_by": "log",
                    "success_messages": [
                        "org.apache.catalina.startup.Catalina start Server startup in"
                    ],
                    "failure_messages": [
                        "Caused by:",
                        "Redis"
                    ],
                    "timeout": 300,
                    "poll_interval": 5
                    }
                },

                "service_readiness": {
                    "ready_by": "ready",
                    "success_messages": [],
                    "failure_messages": [],
                    "timeout": 300,
                    "poll_interval": 5
                }
                }
        }
    ]
}
