{
  "application": {
    "name": "Entropy",
    "version": "1.0.0"
  },

 "console": {
    "banner": false,
    "level": "DEBUG"
  },

  "logging": {
    "level": "INFO",
    "directory": "./logs",
    "rotate_mb": 20,
    "backup_count": 10
  },

  "database": {
    "path": "./database/entropy.db"
  },

  "runtime": {
    "pid": "./runtime/pid",
    "state": "./runtime/state",
    "lock": "./runtime/locks"
  },

  "workflow": {
    "default": "./workflow/default_workflow.json"
  },

  "git": {
    "repository": "./repository"
  },

  "plugins": {
    "directory": "./plugins"
  }
}