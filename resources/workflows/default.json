{
    "name": "Default Deployment Workflow",
    "version": "1.0",
    "description": "Default deployment workflow for Entropy.",
    
    "steps": [

        {
            "id": "validate_environment",
            "order": 1,
            "name": "Validate Environment",
            "plugin": "validate_environment",
            "enabled": false,
            "on_failure": "continue",
            "retry_count": 3
        },

        {
            "id": "execute_db",
            "order": 2,
            "name": "Execute Database Scripts",
            "plugin": "execute_db",
            "enabled": true,
            "on_failure": "continue",
            "retry_count": 3,
            "config": {
                "master_script": "master_calling.sql",
                "validate_only": false,
                "on_failure": "abort"
            }
        },

        {
            "id": "update_configmap",
            "order": 3,
            "name": "Update ConfigMap",
            "plugin": "update_configmap",
            "enabled": true,
            "on_failure": "continue",
            "retry_count": 3,
            "config": {
                "directory": "configmaps",
                "replace": true
            }
        },

        {
            "id": "update_secret",
            "order": 4,
            "name": "Update Secret",
            "plugin": "update_secret",
            "enabled": true,
            "on_failure": "continue",
            "retry_count": 3,
            "config": {
                "directory": "secrets",
                "replace": true
            }
        },

        {
            "id": "execute_shell",
            "order": 5,
            "name": "Execute Shell Scripts",
            "plugin": "execute_shell",
            "enabled": true,
            "on_failure": "continue",
            "retry_count": 3,
            "config": {
                "directory": "shell",
                "on_failure": "abort"
            }
        },

        {
            "id": "deploy_openshift",
            "order": 6,
            "name": "Deploy OpenShift Resources",
            "plugin": "deploy_oc",
            "enabled": true,
            "on_failure": "continue",
            "retry_count": 3,
            "config": {
                "directory": "oc",
                "replace": true
            }
        },

        {
            "id": "generate_report",
            "order": 7,
            "name": "Generate HTML Report",
            "plugin": "generate_report",
            "enabled": true,
            "on_failure": "continue",
            "retry_count": 10
        }

    ]
}