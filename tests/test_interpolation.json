{
    "name": "ReleaseContextInterpolationTest",
    "version": "1.0.0",
    "description": "Test step output interpolation.",

    "variables": {},

    "steps": [
        {
            "name": "BuildReleaseContext",
            "plugin": "release.context_builder",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "release",
                "context_builder"
            ],
            "arguments": {
                "release": "/Users/aravinthselvaraj/Desktop/releases/H004.zip",
                "docker_repository": "/Users/aravinthselvaraj/Desktop/repo",
                "yaml_repository": "/Users/aravinthselvaraj/Desktop/yamls",
                "image_tag": "1.1.7"
            }
        },
        {
            "name": "PrintImages",
            "plugin": "builtin.shell",
            "enabled": true,
            "on_failure": "abort",
            "suppress_result": false,
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.images}"
                ]
            }
        },
        {
            "name": "PrintDeployment",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Deployments: $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.deployment}"
                ]
            }
        },
        {
            "name": "PrintCommonPaths",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Common Paths: $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.common_paths}"
                ]
            }
        },
        {
            "name": "PrintDatabase",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Database: $1",
                "args":[
                    "${steps.BuildReleaseContext.outputs.database}"
                ]
            }
        }
    ]
}
