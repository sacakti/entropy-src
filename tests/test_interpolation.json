{
    "name": "ReleaseContextInterpolationTest",
    "version": "1.0.0",
    "description": "Test step output interpolation.",

    "variables": {
        "SIT" : {
            "yaml_repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT"
        },
        "environment" : "SIT",
        "handoff" : "H004",
        "release": "/Users/aravinthselvaraj/Desktop/releases/${handoff}.zip",
        "docker_repository": "/Users/aravinthselvaraj/Desktop/repo",
        "yaml_repository": "/Users/aravinthselvaraj/Desktop/yamls/$",
        "image_tag": "1.1.10"
    },

    "steps": [
        {
            "name": "BuildReleaseContext",
            "plugin": "release.context_builder",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "release",
                "context_builder"
            ],
            "arguments": {
                "release": "${release}",
                "docker_repository": "${docker_repository}",
                "yaml_repository": "${}",
                "image_tag": "1.1.10"
            }
        },
        {
            "name": "PrintImages",
            "plugin": "builtin.shell",
            "enabled": false,
            "on_failure": "abort",
            "suppress_result": false,
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.images}"
                ]
            }
        },
        {
            "name": "PrintDeployment",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Deployments: $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.deployment}"
                ]
            }
        },
        {
            "name": "PrintCommonPaths",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Common Paths: $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.common_paths}"
                ]
            }
        },
        {
            "name": "PrintDatabase",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Database: $1",
                "args":[
                    "${steps.BuildReleaseContext.outputs.database}"
                ]
            }
        },
        {
            "name": "StageRelease",
            "plugin": "custom.stage_release_copy",
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "release",
                "stage"
            ],
            "arguments": {
                "source": "${steps.BuildReleaseContext.outputs.release.docker_source_release}",
                "destination": "${steps.BuildReleaseContext.outputs.release.docker_dest_repo}",
                "backup": true,
                "rotate_backup_type": "max_files",
                "max_files": 5,
                "max_timestamp": 5,
                "max_timestamp_unit": "days"
            }
        },
        {
            "name": "CmSecretUpdate",
            "plugin": "oc.cm_secret_update",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "openshift",
                "deployment"
            ],
            "arguments": {
                "mode": "deployments",
                "configmaps": "${steps.BuildReleaseContext.outputs.deployment.resources.configmaps}",
                "secrets": "${steps.BuildReleaseContext.outputs.deployment.resources.secrets}",
                "replace": true
            }
        },
        {
            "name": "DeploymentYAMLUpdate",
            "plugin": "oc.deployment",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "mode" : "deployments",
                "repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT",
                "deployments": "${steps.BuildReleaseContext.outputs.deployment.resources.deployments}"
            }
        },
        {
            "name": "ApplyDeployments",
            "plugin": "oc.generic",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "operation": "apply",
                "environment": "SIT",
                "files": "${steps.BuildReleaseContext.outputs.deployment.operations.apply}"
            }
        },
        {
            "name": "ReplaceConfigMapsSecrets",
            "plugin": "oc.generic",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "operation": "replace",
                "environment": "SIT",
                "files": "${steps.BuildReleaseContext.outputs.deployment.operations.replace}"
            }
        }
    ]
}
