{
    "name": "ReleaseContextInterpolationTest",
    "version": "1.0.0",
    "description": "Test step output interpolation.",

    "variables": {
        "tag": "H004",
        "release": "/Users/aravinthselvaraj/Desktop/releases/H004.zip",
        "environment": "UAT",
        "docker_repository": "/Users/aravinthselvaraj/Desktop/repo",
        "yaml_repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT",
        "image_tag": "1.1.10",
        "connection": "${entv:${environment}/DB_CONNECTION}",
        "schemas": "${entv:${environment}/SCHEMAS_*}"
    },

    "workspace": {
        "add_text": true,
        "position": "before",
        "type": "custom",
        "name": "test"
    },

    "steps": [
        {
            "name": "BuildReleaseContext",
            "plugin": "release.context_builder",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "release",
                "context"
            ],
            "arguments": {
                "release": "${release}",
                "docker_repository": "${docker_repository}",
                "yaml_repository": "${yaml_repository}",
                "image_tag": "${image_tag}"
            }
        },
        {
            "name": "Pull Docker Images",
            "plugin": "docker.generic",
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "docker",
                "generic",
                "pull"
            ],
            "arguments": {
                "operation": "pull",
                "images": "${steps.BuildReleaseContext.outputs.images}"
            }
        },
        {
            "name": "CommitRevision",
            "plugin": "builtin.git",
            "enabled": false,
            "on_failure": "abort",
            "arguments": {
                "operation": "revision",
                "repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT"
            }
        },
        {
            "name": "PrintImages",
            "plugin": "builtin.shell",
            "enabled": true,
            "on_failure": "abort",
            "suppress_result": false,
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.images}"
                ]
            }
        },
        {
            "name": "PrintDeployment",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Deployments: $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.deployment}"
                ]
            }
        },
        {
            "name": "PrintCommonPaths",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Common Paths: $1",
                "args": [
                    "${steps.BuildReleaseContext.outputs.common_paths}"
                ]
            }
        },
        {
            "name": "PrintDatabase",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "test"
            ],
            "arguments": {
                "command": "echo Database: $1",
                "args":[
                    "${steps.BuildReleaseContext.outputs.database}"
                ]
            }
        },
        {
            "name": "PrintDatabaseCreds",
            "plugin": "builtin.shell",
            "suppress_result": false,
            "enabled": true,
            "on_failure": "abort",
            "tags": [
                "db_creds"
            ],
            "arguments": {
                "command": "echo \"Connection: $1 Schemas: $2\"",
                "args":[
                    "${connection}",
                    "${schemas}"
                ]
            }
        },
        {
            "name": "StageRelease",
            "plugin": "custom.stage_release_copy",
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "release",
                "stage"
            ],
            "arguments": {
                "source": "${steps.BuildReleaseContext.outputs.release.docker_source_release}",
                "destination": "${steps.BuildReleaseContext.outputs.release.docker_dest_repo}",
                "backup": true,
                "rotate_backup_type": "max_files",
                "max_files": 5,
                "max_timestamp": 5,
                "max_timestamp_unit": "days"
            }
        },
        {
            "name": "CmSecretUpdate",
            "plugin": "oc.cm_secret_update",
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "openshift",
                "deployment"
            ],
            "arguments": {
                "mode": "deployments",
                "configmaps": "${steps.BuildReleaseContext.outputs.deployment.resources.configmaps}",
                "secrets": "${steps.BuildReleaseContext.outputs.deployment.resources.secrets}",
                "replace": false
            }
        },
        {
            "name": "DeploymentYAMLUpdate",
            "plugin": "oc.deployment",
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "openshift",
                "deployment"
            ],
            "arguments": {
                "mode" : "deployments",
                "repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT",
                "deployments": "${steps.BuildReleaseContext.outputs.deployment.resources.deployments}"
            }
        },
        {
            "name": "CreateServicesRoutes",
            "plugin": "oc.services_routes",
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "services_routes",
                "deployment"

            ],
            "arguments": {
                "services": "${steps.BuildReleaseContext.outputs.deployment.resources.services}",
                "routes": "${steps.BuildReleaseContext.outputs.deployment.resources.routes}"
            }
        },
        {
            "name": "ApplyDeployments",
            "plugin": "oc.generic",
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "openshift",
                "deployment"
            ],
            "arguments": {
                "environment": "SIT",
                "operations": "${steps.BuildReleaseContext.outputs.deployment.operations}"
            }
        },
        {
            "name": "RsyncCommonPaths",
            "plugin": "oc.rsync",
            "enabled": true,
            "on_failure": "abort",
            "arguments": {
                "environment": "SIT",
                "rsync_plan": "${steps.BuildReleaseContext.outputs.common_paths}"
            }
        },
        {
            "name": "SQLPlus Plan",
            "plugin": "sqlplus.generic",
            "enabled": false,
            "on_failure": "abort",
            "tags": [
                "sqlplus",
                "plan"
            ],
            "arguments": {
                "mode": "plan",
                "on_error": "continue",
                "connection": "${connection}",
                "schemas": "${schemas}",
                "execution" : "${steps.BuildReleaseContext.outputs.database}"
            }
        },
        {
            "name": "CommitDeployment",
            "plugin": "builtin.git",
            "enabled": false,
            "on_failure": "abort",
            "arguments": {
                "operation": "deployment",
                "repository": "/Users/aravinthselvaraj/Desktop/yamls/SIT",
                "tag": "1.1.10"
            }
        }
    ]
}
